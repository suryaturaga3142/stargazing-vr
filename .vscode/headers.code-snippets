{
	// Place your stargazing-vr workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

  "C Header File Template (.h)": {
    "prefix": "chdr",
    "body": [
      "/*******************************************************************************",
      " * @file        ${TM_FILENAME_BASE}.h",
      " * @brief       ${1:A brief, one-sentence summary of this module's purpose.}",
      " * @details     ${2:A few more details}.",
      " * ",
      " * @see         ${TM_FILENAME_BASE}.c for implementation details.",
      " * ",
      " * @author      LED Chasers",
      " * @date        $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      " * @version     1.0",
      " ******************************************************************************/",
      "",
      "#ifndef ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H",
      "#define ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H",
      "",
      "$0",
      "",
      "#endif /* ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H */"
    ],
    "description": "Creates a standard header file (.h) with a comment block and header guard."
  },

  "C Source File Template (.c)": {
    "prefix": "csrc",
    "body": [
      "/*******************************************************************************",
      " * @file        ${TM_FILENAME_BASE}.c",
      " * @brief       Implements the functionality for the ${1:System Name} module.",
      " * @details     ${2:A few more details}.",
      " * ",
      " * @author      LED Chasers",
      " * @date        $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      " * ",
      " * @note        This module is designed to be driven by interrupts and is not",
      " *              intended to be called from a blocking main loop.",
      " * ",
      " * @copyright   Copyright (c) $CURRENT_YEAR, LED Chasers. All rights reserved.",
      " ******************************************************************************/",
      "",
      "/* ----------------------------- Private Includes --------------------------- */",
      "#include \"${TM_FILENAME_BASE}.h\"",
	  "// ...",
      "",
      "/* ---------------------------- Private Constants --------------------------- */",
      "// ...",
      "",
      "/* ----------------------------- Private Variables -------------------------- */",
      "// ...",
      "",
      "/* ----------------------------- Private Functions -------------------------- */",
      "// ...",
      "",
      "/* ----------------------------- Public Variables -------------------------- */",
      "// ...",
      "",
      "/* ----------------------------- Public Functions --------------------------- */",
      "$0",
      ""
    ],
    "description": "Creates a standard source file (.c) with a comment block and file structure."
  },

  "Doxygen Function Comment": {
    "prefix": "cfunc",
    "body": [
      "/**",
      " * @brief ${1:A brief, one-sentence description of what this function does.}",
      " * ",
      " * @param ${2:param_name} Description of this parameter.",
      " * @return ${3:Description of what this function returns.}",
      " */"
    ],
    "description": "Creates a Doxygen-style function comment block."
  },

  "Doxygen Struct Header": {
    "prefix": "cstruct",
    "body": [
      "/**",
      " * @brief ${1:A brief, one-sentence description of this struct.}",
      " * @details ${2:A more detailed description of the struct's purpose and members.}",
      " */"
    ],
    "description": "Inserts a Doxygen-style comment block for a struct."
  }
}