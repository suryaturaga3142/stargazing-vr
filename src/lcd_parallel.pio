;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; @file       lcd_parallel.pio
; @brief      PIO assembly for 16-bit 8080 Parallel Interface (Manual SET/NOP)
; @author     LED Chasers
; @date       2025-11-12
; @version    3.0 (NOP-based timing)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.program lcd_parallel

; PIN MAPPING: 
;  OUT pins  = D0-D15 + D/C (17 pins total). [Mapped to GP2 - GP18]
;  SET pin   = WR (1 pin).                   [Mapped to GP19]

.wrap_target
    pull   block        ; 1. Wait for 32-bit word from TX FIFO. WR is High (Idle).
                        ;    Bits 0-15: Data, Bit 16: DC.
                        
    out    pins, 17     ; 2. Output 16-bit Data + DC bit to pins.
                        ;    WR is STILL High here. This guarantees Data Setup Time (tdst).
    
    set    pins, 0      ; 3. Drive WR Low (Active Write Strobe).
    nop                 ;    Hold WR Low (Ensures minimum Pulse Width Low).
    nop                 ;    Hold WR Low.

    set    pins, 1      ; 4. Drive WR High (Latch Data on rising edge).
    nop                 ;    Hold WR High (Ensures minimum Pulse Width High).
    nop                 ;    Hold WR High.
.wrap