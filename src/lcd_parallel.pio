.program lcd_parallel
.side_set 1 opt

; Purpose:
; Output 16 bits of pixel data to the LCD on each write strobe (WR).
; Uses autopull so the SM continuously requests 18-bit words from TX FIFO.
; Side-set controls WR (active low pulse).
; For RGB 565 LCD

.wrap_target
    out pins, 17     ; Output 17 bits to DB0..DB15
    out null, 15     ; this will remove the lsb
    nop side 0 [2]   ; Drive WR low, hold for 3 cycles
    nop  side 1 [3]   ; Drive WR high, hold for 4 cycles
.wrap

% c-sdk {
#include "pico/stdlib.h"
#include "hardware/pio.h"

static inline void lcd_parallel_program_init(
    PIO pio, uint sm, uint offset,
    uint pin_data_base,   // First data pin (DB0)
    uint pin_wr,          // WR strobe pin
    float clkdiv
) {
    pio_sm_config c = lcd_parallel_program_get_default_config(offset);

    sm_config_set_out_pins(&c, pin_data_base, 17);  // DB0..DB15 + DC
    sm_config_set_sideset_pins(&c, pin_wr);         // WR via side-set

    sm_config_set_out_shift(&c,
        false,   // shift right
        true,   // autopull
        32);    // pull threshold

    sm_config_set_clkdiv(&c, clkdiv);

    // Init pins
    for (uint i = 0; i < 17; i++)
        pio_gpio_init(pio, pin_data_base + i);
    pio_gpio_init(pio, pin_wr);

    // Set directions
    pio_sm_set_consecutive_pindirs(pio, sm, pin_data_base, 17, true);
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << pin_wr), (1u << pin_wr));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
